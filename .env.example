# Authentication Secret (Used to cryptographically sign session tokens and access authorization)
AUTH_SECRET="super-secret-auth-key-32-chars-min"

# Neon PostgreSQL Database (Primary Persistent Store)
DATABASE_URL="postgresql://user:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Upstash Redis Cache (Production Queue & Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# Supabase Storage (Private Media Bucket & Signed Storage URL Generation)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SECRET_KEY="your_supabase_secret_key_here"
SUPABASE_BUCKET="media-files"
MEDIA_STORAGE_BUCKET="media-files"

# EasyDown API Token (Server-Side Social Media Video Extraction)
# Endpoint: https://api.easydown.org/api/v1/parse
EASYDOWN_TOKEN="your_easydown_token_here"

# RapidAPI Key for Social Download Service (Server-Side Fallback)
RAPIDAPI_KEY="your_rapidapi_key_here"

# yt-dlp Extractor Engine
YTDLP_PATH="/app/applet/yt-dlp"
YTDLP_COOKIES=""
YTDLP_TIMEOUT_SECONDS="300"
