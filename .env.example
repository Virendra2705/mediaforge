# Authentication Secret (Used to cryptographically sign session tokens and access authorization)
AUTH_SECRET=

# Administrator Account Configuration (Fails closed if unset; exact email match only)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="your-strong-admin-password"
# Optional: pre-hashed password (scrypt:<salt_hex>:<hash_hex>)
# ADMIN_PASSWORD_HASH=""

# Neon PostgreSQL Database (Primary Persistent Store)
DATABASE_URL="postgresql://user:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Optional PEM CA for private/custom PostgreSQL certificate chains. Verification remains enabled.
DATABASE_CA_CERT=""
# Only enable for local development/tests; production always requires PostgreSQL.
ALLOW_IN_MEMORY_DATABASE=false

# Upstash Redis Cache (Production Queue & Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# Supabase Storage (Private Media Bucket & Signed Storage URL Generation)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SECRET_KEY="your_supabase_secret_key_here"
SUPABASE_BUCKET="media-files"
MEDIA_STORAGE_BUCKET="media-files"

# EasyDown API Token (Server-Side Social Media Video Extraction)
# Endpoint: https://api.easydown.org/api/v1/parse
EASYDOWN_TOKEN="your_easydown_token_here"

# RapidAPI Key for Social Download Service (Server-Side Fallback)
RAPIDAPI_KEY="your_rapidapi_key_here"

# yt-dlp Extractor Engine
YTDLP_PATH="/opt/yt-dlp/bin/yt-dlp"
# Required in production. The operator-managed proxy must deny private, loopback,
# link-local, metadata, reserved, and non-public destinations on every request.
YTDLP_PROXY_URL="https://egress-proxy.example.com:443"
YTDLP_COOKIES=""
YTDLP_TIMEOUT_SECONDS="300"
# Production defaults to fail-closed when Redis rate limiting is unavailable.
RATE_LIMIT_FAILURE_POLICY="closed"

# Google AdSense Publisher Client ID (Auto Ads & Manual Units)
# Replace with your official publisher ID from Google AdSense (e.g. ca-pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_CLIENT_ID=""
